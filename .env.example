# Browser-safe: VITE_ prefix exposes these to the client bundle
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only: NO VITE_ prefix — never exposed to the browser.
# Set this in Vercel: Settings → Environment Variables → SUPABASE_SERVICE_ROLE_KEY
# Used only by /api/*.js Vercel serverless functions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
